#, python-format
msgid ""
"%(field)s: Bitte eine Bewertung von %(low)s bis %(high)s Sternen eingeben."
msgstr "%(field)s：請輸入 %(low)s 到 %(high)s 星的評分。"

msgid "Bitte ein gültiges Datum eingeben, z. B. 24.12.2015."
msgstr "請輸入有效日期，例如 24.12.2015。"

msgid "Bitte Datum und Uhrzeit eingeben, z. B. 24.12.2015 18:30."
msgstr "請輸入日期和時間，例如 24.12.2015 18:30。"

#, python-format
msgid "%(field)s: Bitte eine ganze Zahl eingeben."
msgstr "%(field)s：請輸入整數。"

#, python-format
msgid "%(field)s: Bitte eine Zahl eingeben."
msgstr "%(field)s：請輸入數字。"

#, python-format
msgid "%(field)s: mindestens %(n)s."
msgstr "%(field)s：至少 %(n)s。"

#, python-format
msgid "%(field)s: höchstens %(n)s."
msgstr "%(field)s：最多 %(n)s。"

#, python-format
msgid "%(field)s: Unbekannter Datensatz."
msgstr "%(field)s：未知記錄。"

#, python-format
msgid "%(field)s: Hier passt nur ein Datensatz."
msgstr "%(field)s：此處只能選一筆記錄。"

#, python-format
msgid "%(field)s wird berechnet und kann nicht eingegeben werden."
msgstr "%(field)s 為計算欄位，無法輸入。"

#, python-format
msgid "%(field)s: Dateien werden hochgeladen, nicht eingegeben."
msgstr "%(field)s：檔案需上傳，不能輸入。"

#, python-format
msgid "%(field)s ist ein Pflichtfeld."
msgstr "%(field)s 為必填欄位。"

msgid "Bitte eine gültige E-Mail-Adresse eingeben."
msgstr "請輸入有效的電子郵件地址。"

msgid "Bitte einen gültigen Link eingeben."
msgstr "請輸入有效的連結。"

msgid "Bitte eine gültige Telefonnummer eingeben."
msgstr "請輸入有效的電話號碼。"

#, python-format
msgid "%(field)s: Unbekannte Auswahl."
msgstr "%(field)s：未知選項。"

#, python-format
msgid "%(field)s nimmt keine Werte auf."
msgstr "%(field)s 不儲存值。"

#, python-format
msgid "%(field)s: Ungültiger Wert."
msgstr "%(field)s：無效的值。"

msgid "Ja"
msgstr "是"

msgid "Nein"
msgstr "否"

#, python-format
msgid "Auf dem Server sind nur noch %(gb)s GB frei."
msgstr "伺服器僅剩 %(gb)s GB 可用空間。"

#, python-format
msgid "Serverfehler in den letzten 24 Stunden: %(n)s."
msgstr "過去 24 小時內的伺服器錯誤：%(n)s。"

msgid "Die Datei ist größer als 20 MB."
msgstr "檔案大於 20 MB。"

msgid "Sie sind nicht mehr angemeldet."
msgstr "登入已失效。"

msgid "Die Datei ist zu groß."
msgstr "檔案過大。"

msgid "Sekretariat"
msgstr "教務處"

msgid "Schulleitung"
msgstr "校領導"

#, python-format
msgid ""
"Diese Datenbank enthält Daten des Moduls %(names)s, das in dieser DataFluss-"
"Version fehlt. Sie bleibt unverändert und lässt sich mit einer DataFluss-"
"Version mit diesem Modul öffnen."
msgstr ""
"此資料庫包含模組 %(names)s 的資料，而目前 DataFluss 版本沒有該模組。資料庫保持不變，可用帶有該模組的 DataFluss "
"版本開啟。"

msgid ""
"Voller Zugriff, inklusive Masken, Vorlagen, Benutzer und Export von "
"Passwörtern."
msgstr "完整存取權限，包括表單版面、範本、使用者和密碼匯出。"

msgid "Stammdaten pflegen, Passwörter anzeigen und Zugangsblätter drucken."
msgstr "維護基本資料、檢視密碼並列印帳號單。"

msgid "Daten und Berichte lesen, keine Passwörter."
msgstr "檢視資料和報告，不含密碼。"

msgid "Team"
msgstr "團隊"

msgid "Gast"
msgstr "訪客"

msgid "Startseite"
msgstr "首頁"

msgid "Die Startseite mit Zahlen, Aufgaben und der Suche."
msgstr "帶有統計、待辦事項和搜尋的首頁。"

msgid "Liste, Datenblätter und Suche; Bearbeiten heißt anlegen und ändern."
msgstr "清單、資料頁和搜尋；編輯表示新增和修改。"

msgid "Archivieren und löschen"
msgstr "封存和刪除"

msgid "Schüler archivieren, in den Papierkorb legen und zurückholen."
msgstr "封存學生、移入資源回收筒並還原。"

msgid "Klassen und Schuljahreswechsel"
msgstr "班級和學年更替"

msgid "Klassen anlegen und ändern, das Schuljahr wechseln."
msgstr "新增和修改班級，進行學年更替。"

msgid "Personal archivieren, in den Papierkorb legen und zurückholen."
msgstr "封存教職員、移入資源回收筒並還原。"

msgid "Erziehungsberechtigte und ihre Kinder."
msgstr "監護人及其子女。"

msgid "Geräte und Schäden"
msgstr "設備和損壞"

msgid "Geräte, Ausgaben, Rücknahmen und Schadensfälle."
msgstr "設備、發放、回收和損壞案例。"

msgid "Benutzernamen und Passwörter der Plattformen."
msgstr "各平台的使用者名稱和密碼。"

msgid "Passwörter anzeigen"
msgstr "顯示密碼"

msgid "Ein verborgenes Passwort im Klartext zeigen."
msgstr "以明文顯示隱藏的密碼。"

msgid "Mit Passwörtern exportieren"

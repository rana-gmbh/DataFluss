msgstr "Show a hidden password in plain text."

msgid "Mit Passwörtern exportieren"
msgstr "Export with passwords"

msgid "Zugänge samt Passwörtern als Datei."
msgstr "Logins with their passwords as a file."

msgid "Plattformen verwalten"
msgstr "Manage platforms"

msgid "Plattformen anlegen und ändern."
msgstr "Create and change platforms."

msgid "Drucken"
msgstr "Print"


msgid "Bitte ein gültiges Datum eingeben, z. B. 24.12.2015."
msgstr "Please enter a valid date, e.g. 24.12.2015."

msgid "Bitte Datum und Uhrzeit eingeben, z. B. 24.12.2015 18:30."
msgstr "Please enter a date and time, e.g. 24.12.2015 18:30."

#, python-format
msgid "%(field)s: Bitte eine ganze Zahl eingeben."
msgstr "%(field)s: Please enter a whole number."

#, python-format
msgid "%(field)s: Bitte eine Zahl eingeben."
msgstr "%(field)s: Please enter a number."

#, python-format
msgid "%(field)s: mindestens %(n)s."
msgstr "%(field)s: at least %(n)s."

#, python-format
msgid "%(field)s: höchstens %(n)s."
msgstr "%(field)s: at most %(n)s."

#, python-format
msgid "%(field)s: Unbekannter Datensatz."
msgstr "%(field)s: Unknown record."

#, python-format
msgid "%(field)s: Hier passt nur ein Datensatz."
msgstr "%(field)s: Only one record fits here."

#, python-format
msgid "%(field)s wird berechnet und kann nicht eingegeben werden."
msgstr "%(field)s is calculated and cannot be entered."

#, python-format
msgid "%(field)s: Dateien werden hochgeladen, nicht eingegeben."
msgstr "%(field)s: Files are uploaded, not typed in."

#, python-format
msgid "%(field)s ist ein Pflichtfeld."
msgstr "%(field)s is required."

msgid "Bitte eine gültige E-Mail-Adresse eingeben."
msgstr "Please enter a valid email address."

msgid "Bitte einen gültigen Link eingeben."
msgstr "Please enter a valid link."

msgid "Bitte eine gültige Telefonnummer eingeben."
msgstr "Please enter a valid phone number."


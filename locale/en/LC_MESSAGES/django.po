msgstr "Install new versions."

msgid "Sicherungen anlegen und zurückspielen."
msgstr "Make and restore backups."

msgid "Protokoll"
msgstr "Audit log"

msgid "Wer wann was getan hat."
msgstr "Who did what and when."

msgid "Module"
msgstr "Modules"

msgid "Die Datei ist nicht verschlüsselt."
msgstr "The file is not encrypted."


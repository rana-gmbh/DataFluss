# Variables for production. On Coolify they are set in the application's Environment Variables.
# See docs/INSTALL-COOLIFY.md. Coolify provides the domain, version and application ID itself.
DEBUG=0
SECRET_KEY=
VAULT_KEY=
DATABASE_URL=
# Start value only. Afterwards IT switches this under Einstellungen > Benutzer.
REQUIRE_2FA=1
TIME_ZONE=Europe/Berlin
SERVER_ID=eu
CARD_INPUT_FORMAT=hex

# Update button
COOLIFY_API_URL=http://coolify:8080
COOLIFY_DASHBOARD_URL=
COOLIFY_API_TOKEN=
GITHUB_TOKEN=

# Microsoft 365 sign-in, active once ID and secret are set.
# 21Vianet tenants use OIDC_AUTHORITY=https://login.partner.microsoftonline.cn
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT=common

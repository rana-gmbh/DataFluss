      {"type": "spacer", "h_mm": 12}, {"type": "signature", "text": "Datum, Unterschrift"}]}]}]}},
    {"table": "buecher", "name": "Buchkarte", "description": "Ein Buch mit allen Ausleihen.", "tree": {"page": {"preset": "a4"}, "rows": [{"cols": [{"w": 12, "items": [
      {"type": "heading", "text": "{{f_titel}}"}, {"type": "text", "text": "{{f_autor}} · Signatur {{f_signatur}} · ISBN {{f_isbn}}"},
      {"type": "list", "link": "@ausleihen.f_buch", "columns": [{"key": "f_ausgabe", "title": "Ausgegeben"}, {"key": "f_schueler", "title": "Schüler"}, {"key": "f_rueckgabe", "title": "Zurück"}]}]}]}]}}
  ],
  "views": [

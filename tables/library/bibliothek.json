      {"id": "s2", "title": "Termine", "titles": {"en": "Dates", "zh-hans": "日期", "zh-hant": "日期"}, "items": [{"type": "field", "field": "f_ausgabe", "w": 4}, {"type": "field", "field": "f_faellig", "w": 4}, {"type": "field", "field": "f_rueckgabe", "w": 4}, {"type": "field", "field": "f_ueberfaellig", "w": 4}, {"type": "field", "field": "f_notiz", "w": 12}]},
      {"id": "s3", "title": "", "items": [{"type": "block", "block": "history", "w": 12}]}
    ]}]}}
  ],
  "prints": [

      },
      {
       "value": "Sonstiges",
       "labels": {
        "en": "Other",
        "zh-hans": "其他",
        "zh-hant": "其他"
       }
      }
     ]
    },
    {
     "key": "f_verantwortlich",
     "label": "Verantwortlich",

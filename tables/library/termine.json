        "en": "Trip",
        "zh-hans": "出游",
        "zh-hant": "出遊"
       }
      },
      {
       "value": "Fest",
       "labels": {
        "en": "Celebration",
        "zh-hans": "庆典",
        "zh-hant": "慶典"

msgstr "no text"

#, python-format
msgid "Freigegeben: %(title)s"
msgstr "Approved: %(title)s"

msgid "Bitte eine Begründung für den Einsender schreiben."
msgstr "Please write a reason for the person who submitted it."

#, python-format
msgid "Abgelehnt: %(title)s"
msgstr "Rejected: %(title)s"

#, python-format
msgid "%(name)s ist größer als 5 MB."
msgstr "%(name)s is larger than 5 MB."

#, python-format
msgid "%(name)s: bitte PNG, JPEG oder WebP."
msgstr "%(name)s: please use PNG, JPEG or WebP."

#, python-format
msgid "%(name)s ist kein lesbares Bild."
msgstr "%(name)s is not a readable image."

msgid "Die Datei ist keine gültige Vorlage."
msgstr "The file is not a valid template."

#, python-format
msgid "Die Kennung %(id)s ist vergeben. Bitte eine eigene wählen."
msgstr "The key %(id)s is taken. Please choose your own."

#, python-format
msgid "Eine neue Version braucht dieselbe Kennung wie die Vorlage (%(id)s)."
msgstr "A new version needs the same key as the template (%(id)s)."

#, python-format
msgid ""
"Die Versionsnummer muss größer sein als %(n)s, die zuletzt freigegebene."
msgstr "The version number must be greater than %(n)s, the last approved one."

#, python-format
msgid "Neue Vorlage zum Prüfen: %(title)s"
msgstr "New template to review: %(title)s"

#, python-format
msgid "Ihre Vorlage ist freigegeben: %(title)s"
msgstr "Your template is approved: %(title)s"

#, python-format
msgid "Ihre Vorlage wurde nicht freigegeben: %(title)s"
msgstr "Your template was not approved: %(title)s"

msgid "Neue Bewertung zum Prüfen"
msgstr "New review to check"

#, python-format
msgid "%(n)s von 5 Sternen"
msgstr "%(n)s of 5 stars"

msgid "Neueste"
msgstr "Newest"

msgid "Beste"
msgstr "Best rated"

msgid "Meist geladen"
msgstr "Most downloaded"

msgid "Das ging zu schnell. Bitte noch einmal versuchen."
msgstr "That was too quick. Please try again."

msgid "Bitte den Bedingungen zustimmen."
msgstr "Please agree to the terms."

msgid "Bitte eine Vorlagendatei wählen."
msgstr "Please choose a template file."

msgid "Heute wurden schon viele Vorlagen hochgeladen. Bitte morgen weiter."
msgstr "Many templates were uploaded today already. Please continue tomorrow."

msgid "Danke! Die Vorlage wird geprüft und erscheint nach der Freigabe."
msgstr ""
"Thank you! The template will be reviewed and appears once it is approved."

msgid "Die Vorlage ist zurückgezogen."
msgstr "The template is withdrawn."

msgid "Die Vorlage wird wieder gezeigt."
msgstr "The template is shown again."

msgid "Eigene Vorlagen lassen sich nicht bewerten."
msgstr "You cannot rate your own templates."

msgid "Ihre Bewertung ist gelöscht."
msgstr "Your review is deleted."

msgid "Heute wurden schon viele Bewertungen abgegeben. Bitte morgen weiter."
msgstr "Many reviews were given today already. Please continue tomorrow."

msgid "Bitte 0,5 bis 5 Sterne wählen."
msgstr "Please choose 0.5 to 5 stars."

msgid "Danke! Der Text erscheint nach der Prüfung."
msgstr "Thank you! The text appears once it is checked."

msgid "Danke für Ihre Bewertung!"
msgstr "Thank you for your review!"

msgid "Bitte kurz sagen, was nicht stimmt."
msgstr "Please say briefly what is wrong."

msgid "Neue Meldung"
msgstr "New report"

msgid "Danke, wir sehen es uns an."
msgstr "Thank you, we will look into it."

msgid "Heute wurde schon viel gemeldet. Bitte morgen weiter."
msgstr "Much was reported today already. Please continue tomorrow."

msgid "Bitte eine gültige E-Mail-Adresse eingeben."
msgstr "Please enter a valid e-mail address."

msgid "Zu viele Anmeldeversuche. Bitte später noch einmal versuchen."
msgstr "Too many sign-in attempts. Please try again later."

msgid "Anmelden bei DataFluss Vorlagen"
msgstr "Sign in to DataFluss Templates"

msgid "Bitte einen Namen angeben."
msgstr "Please enter a name."

msgid "Gespeichert."
msgstr "Saved."

msgid "Zum Löschen bitte die eigene E-Mail-Adresse eingeben."
msgstr "To delete, please enter your own e-mail address."

msgid "Das Konto ist gelöscht."
msgstr "The account is deleted."

msgid "Zu viele Versuche. Bitte später noch einmal versuchen."
msgstr "Too many attempts. Please try again later."

msgid "Der Code stimmt nicht."
msgstr "The code is not right."

msgid "beantragt"
msgstr "requested"

msgid "freigeschaltet"
msgstr "unlocked"

msgid "gesperrt"
msgstr "blocked"

msgid "Bitte kurz beschreiben, was Sie veröffentlichen möchten."
msgstr "Please describe briefly what you want to publish."

msgid "Neuer Antrag auf Websites"
msgstr "New request for websites"

msgid "Danke! Ihr Antrag wird geprüft; Sie bekommen eine E-Mail."
msgstr "Thank you! Your request will be reviewed; you will get an email."

msgid "Websites sind für Ihr Konto noch nicht freigeschaltet."
msgstr "Websites are not unlocked for your account yet."

msgid "Bitte einen Namen eingeben."
msgstr "Please enter a name."

#, python-format
msgid "Mehr als %(n)s Websites gehen nicht."
msgstr "No more than %(n)s websites are possible."

msgid "Die Website ist gelöscht."
msgstr "The website is deleted."

msgid "Bitte die Adresse der Website und einen Grund angeben."
msgstr "Please enter the website's address and a reason."

msgid "Neue Meldung einer Website"
msgstr "New report of a website"

msgid "Bitte einen Grund für das Konto schreiben."
msgstr "Please write a reason for the account."

msgid "Ihre Websites sind freigeschaltet"
msgstr "Your websites are unlocked"

msgid "Ihr Antrag auf Websites"
msgstr "Your request for websites"

msgid "Nicht gefunden"
msgstr "Not found"

msgid "Diese Seite gibt es nicht"
msgstr "This page does not exist"

msgid ""
"Vielleicht wurde die Vorlage zurückgezogen, oder der Link ist nicht "
"vollständig."
msgstr "Perhaps the template was withdrawn, or the link is incomplete."

msgid "Zu allen Vorlagen"
msgstr "To all templates"

msgid "Vorlagen"
msgstr "Templates"

msgid ""
"Fertige Datenbank-Vorlagen für DataFluss: finden, herunterladen, teilen und "
"bewerten."
msgstr ""
"Ready-made database templates for DataFluss: find, download, share and rate "
"them."

msgid "Datenbank-Vorlagen für DataFluss"
msgstr "Database templates for DataFluss"

msgid "Zum Inhalt springen"
msgstr "Skip to content"

msgid "Hauptmenü"
msgstr "Main menu"

msgid "Stöbern"
msgstr "Browse"

msgid "Teilen"
msgstr "Share"

msgid "Meine Vorlagen"
msgstr "My templates"

msgid "Websites"
msgstr "Websites"

msgid "Prüfen"
msgstr "Review"

msgid "Abmelden"
msgstr "Sign out"

msgid "Anmelden"
msgstr "Sign in"

msgid "Vorlagen für"
msgstr "Templates for"

msgid "geteilt unter"
msgstr "shared under"

msgid "Impressum"
msgstr "Legal notice"

msgid "Datenschutz"
msgstr "Privacy"

msgid "Nutzungsbedingungen"
msgstr "Terms of use"

msgid "Offiziell"
msgstr "Official"

msgid "neu"
msgstr "new"


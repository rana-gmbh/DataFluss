msgid "Sammlungen und Haushalt"
msgstr "Collections and household"

msgid "Verein und Ehrenamt"
msgstr "Clubs and volunteering"

msgid "Schule und Bildung"
msgstr "School and education"

msgid "Arbeit und Büro"
msgstr "Work and office"

msgid "Freizeit und Hobby"
msgstr "Leisure and hobbies"

msgid "Sonstiges"
msgstr "Other"

msgid "gelöschtes Konto"
msgstr "deleted account"


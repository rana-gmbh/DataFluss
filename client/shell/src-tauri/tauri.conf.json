{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataFluss",
  "version": "1.3.0",
  "identifier": "de.rana.datafluss",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../dist/schule-sidecar/": "sidecar/" },
    "macOS": { "minimumSystemVersion": "13.0", "hardenedRuntime": true }
  }
}
